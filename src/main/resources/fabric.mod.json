{
  "schemaVersion": 1,
  "id": "uprightelytra",
  "version": "${version}",
  "name": "Upright Elytra",
  "description": "Elytra flight with an upright pose, a normal standing hitbox and a normal camera height. Can be toggled from Mod Menu.",
  "authors": ["abo9kr"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.example.uprightelytra.UprightElytraMod"],
    "modmenu": ["com.example.uprightelytra.ModMenuIntegration"]
  },
  "mixins": [
    "uprightelytra.mixins.json",
    { "config": "uprightelytra.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*"
  }
}
